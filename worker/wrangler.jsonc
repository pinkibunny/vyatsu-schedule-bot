{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vyatsu-schedule-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "vars": {
    "SCHEDULE_URL": "https://raw.githubusercontent.com/pinkibunny/vyatsu-schedule-bot/main/data/schedule.json"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "vyatsu-bot-stats",
      "database_id": "a28007f9-3e84-4f27-9c8e-6403312e9b02"
    }
  ]
}
